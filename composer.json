{
    "name": "softspring/translatable-bundle",
    "description": "Symfony form type for translatable fields",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^2.13|^3.2|^4.2",
        "doctrine/orm": "^2.19|^3.3",
        "symfony/doctrine-bridge": "^6.4|^7.4|^8.0",
        "symfony/config": "^6.4|^7.4|^8.0",
        "symfony/dependency-injection": "^6.4|^7.4|^8.0",
        "symfony/form": "^6.4|^7.4|^8.0",
        "symfony/http-kernel": "^6.4|^7.4|^8.0",
        "twig/twig": "^2.16|^3.14"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "google/cloud-translate": "^1.17",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.2",
        "softspring/dynamic-form-type": "^6.0@dev",
        "symfony/framework-bundle": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\TranslatableBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\TranslatableBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
